{
  "version": 2,
  "framework": null,
"buildCommand": "pnpm --filter @workspace/api-server run build && pnpm --filter @workspace/senorita run build && mkdir -p dist && cp -r senorita/dist/* dist/",
  "outputDirectory": "dist",
  "installCommand": "pnpm install --frozen-lockfile",
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api/index.ts" },
    { "source": "/(.*)", "destination": "/index.html" }
  ],
  "functions": {
    "api/index.ts": {
      "memory": 2048,
      "maxDuration": 60,
      "includeFiles": "artifacts/api-server/dist/app.cjs"
    }
  }
}
