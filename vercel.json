{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "installCommand": "pnpm install --frozen-lockfile",
  "services": {
    "api-server": {
      "root": "artifacts/api-server",
      "framework": "express",
      "routePrefix": "/api"
    },
    "senorita": {
      "root": "artifacts/senorita",
      "framework": "vite",
      "routePrefix": "/"
    }
  }
}